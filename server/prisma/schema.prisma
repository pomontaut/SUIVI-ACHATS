generator client {
  provider      = "prisma-client-js"
  // "native" pour le dev local (glibc), "linux-musl-openssl-3.0.x" pour
  // l'image de production node:22-alpine (musl + OpenSSL 3).
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Suivi opérationnel des achats (une ligne = un besoin d'achat sur un chantier)
model Operation {
  id                  String   @id @default(cuid())
  date                String? // dd/mm/yy saisi par l'utilisateur
  dem                 String? // demandeur
  ent                 String? // entité
  chant               String? // n° chantier
  nom                 String? // nom du chantier
  type                String? // exploitation / soumission / ...
  impl                String? // implantation oui/non
  fourn               String? // catégorie de fournitures
  prec                String? // précisions du besoin
  etape               String? // étape du process achat
  consult             String? // JSON array de dates/consultations
  rem                 String? // remarques
  launch              String?
  retour              String?
  retourMax           String?
  dateCmd             String?
  dateLivraison       String?
  dateLivraisonReelle String?
  numCmd              String?
  budget              String?
  typeBudget          String?
  montant             String?
  gain                String?
  tco                 String?
  fournisseur         String?
  typeActionAchat     String?
  comment             String?
  statutAo            String?
  prio                String?  @default("P2")
  vuDate              String?  // date (YYYY-MM-DD) du dernier "vu" ; case cochée seulement si === aujourd'hui
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

// Sujets transverses (management achats, projets IT, etc.), non liés à un chantier précis
model Transverse {
  id        String   @id @default(cuid())
  date      String?
  dem       String?
  ent       String?
  nom       String?
  type      String?
  prec      String?
  budget    String?
  rem       String?
  action    String?
  retour    String?
  prio      String?  @default("P2")
  statut    String?  @default("Actif")
  vuDate    String?  // date (YYYY-MM-DD) du dernier "vu" ; case cochée seulement si === aujourd'hui
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Liste de tâches (to-do) de l'équipe achats
model Todo {
  id             String   @id @default(cuid())
  prio           String?  @default("P2")
  statut         String?  @default("Actif")
  qui            String?
  quoi           String?
  deadline       String?
  action         String?
  deadlineAction String?
  vuDate         String?  // date (YYYY-MM-DD) du dernier "vu" ; case cochée seulement si === aujourd'hui
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// Non-conformités fournisseur (qualité, retard, quantité...)
model NonConformite {
  id          String   @id @default(cuid())
  date        String?
  fournisseur String?
  ent         String?
  chant       String?
  nom         String?
  ctx         String? // contact / interlocuteur
  montantCmd  String?
  catNC       String? // catégorie (retard livraison, qualité, ...)
  typeNC      String? // gravité: mineur/majeur/critique
  statut      String? // statut de traitement de la NC
  statutNC    String? @default("En cours") // en cours / clôturé (simple)
  montantNC   String?
  noteCredit  String?
  noteCreditNum String? // n° / référence de la note de crédit d'origine émise par le fournisseur
  rem         String?
  livraisonId String? // rattachement optionnel à une livraison en retard
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Suivi des livraisons (délais, retards, statuts de réception)
model Livraison {
  id                  String   @id @default(cuid())
  // Lien vers l'opération source quand la ligne est reportée automatiquement
  // depuis le suivi opérationnel (cf. syncLivraisonsFromOperations) ; null
  // pour une ligne saisie manuellement, indépendante de l'Opérationnel.
  operationId         String?  @unique
  chant               String?
  nom                 String?
  numCmd              String?
  ent                 String?
  dem                 String?
  fournisseur         String?
  prec                String?
  montant             String?
  dateCmd             String?
  dateConfirm         String?
  dateLivraison       String? // prévue
  dateLivraisonReelle String?
  remLiv              String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

// Suivi des appels d'offres / soumissions envoyées aux fournisseurs
model AppelOffre {
  id String @id @default(cuid())
  // Lien vers l'opération source quand la ligne est générée automatiquement
  // (cf. syncAppelsOffresFromOperations : TCO=oui + fournisseur listé dans
  // Consultation) ; null pour une ligne saisie manuellement.
  operationId         String?
  // Tag de consultation d'origine (une entrée de Operation.consult) : sert
  // d'identité stable pour la resynchronisation, indépendamment du champ
  // fournisseur ci-dessous qui reste librement modifiable une fois la
  // ligne créée (ex: préciser "Helmut Breschan AG" là où la consultation
  // ne portait que "Breschan") sans que la ligne soit reconstruite/perdue
  // au prochain resync.
  consultTag          String?
  date                String?
  chant               String?
  nom                 String?
  ent                 String?
  dem                 String?
  fournisseur         String?
  prec                String?
  statut              String?  @default("En cours")
  dateEnvoi           String? // miroir Operation.launch (colonne "Lancement")
  dateRetourMax       String? // miroir Operation.retourMax
  dateRetour          String?
  rem                 String?
  offreFournisseur    String? // montant de l'offre du fournisseur, en HT
  offreFichierNom     String? // nom original du document d'offre joint (devis/PDF)
  offreFichierUrl     String? // chemin de téléchargement du document d'offre joint
  offreMontantAuto    Boolean  @default(false) // true si offreFournisseur a été extrait automatiquement du fichier joint (à vérifier), jamais écrasé une fois modifié à la main
  offreExtractionNote String? // commentaire de l'extraction automatique (ambiguïtés, hypothèses)
  comparatifTechnique String? // notes du comparatif technique de cette offre
  validation          String? // adjudicataire / pas répondu / non retenu
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([operationId, consultTag])
}

// Statut de commande au niveau du "sujet AO" (regroupement virtuel de
// plusieurs lignes AppelOffre par date+chantier+objet, cf.
// AppelsOffresPage.tsx#buildAoGroups). Le sujet n'a pas d'existence propre
// côté AppelOffre, donc ce statut est stocké séparément, indexé par la même
// clé de regroupement que le client calcule.
model AoSujet {
  id             String   @id @default(cuid())
  cle            String   @unique
  statutCommande String?  @default("En cours")
  numCmd         String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// Suivi administratif des commandes : reporté automatiquement depuis
// l'Opérationnel dès qu'un n° de commande y est saisi (à partir du
// 25/08/2026, pour ne pas réimporter en masse les anciennes valeurs
// d'espace réservé type "x" laissées par la reprise de données). Confirme
// et BL sont saisis manuellement ici.
model SuiviAdministratif {
  id           String   @id @default(cuid())
  operationId  String?  @unique
  date         String?
  chant        String?
  nom          String?
  ent          String?
  dem          String?
  fournisseur  String?
  prec         String?
  fourn        String? // catégorie de fournitures (miroir Operation.fourn), pour savoir si le BL est applicable
  numCmd       String?
  dateCmd      String?
  confirmation String?
  confirmationFichierNom String?
  confirmationFichierUrl String?
  bl           String?
  blFichierNom String?
  blFichierUrl String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Poste budgétaire d'un "sujet AO" (même regroupement que AoSujet.cle :
// date + chantier + objet), pour un comparatif financier détaillé poste par
// poste entre les fournisseurs consultés, à l'image des comparatifs de
// référence transmis par l'utilisateur (n° article, libellé, budget INDUNI,
// puis un montant par fournisseur avec écarts calculés). Un poste est
// partagé par tous les fournisseurs du sujet ; son budget est saisi
// manuellement (aucune source PDF pour le budget interne).
model AoPoste {
  id        String   @id @default(cuid())
  sujetCle  String
  reference String?
  libelle   String?
  budget    String?
  ordre     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Montant chiffré par un fournisseur (une ligne AppelOffre) pour un poste
// donné. montantAuto=true si extrait automatiquement de l'offre PDF jointe
// (à vérifier), jamais écrasé une fois modifié à la main.
model AoPosteMontant {
  id           String   @id @default(cuid())
  posteId      String
  appelOffreId String
  montant      String?
  montantAuto  Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([posteId, appelOffreId])
}

// Cahier des charges : base de connaissance des questions à poser aux
// demandeurs pour chaque type de fourniture/prestation, indépendante du
// suivi opérationnel (aucune synchro automatique). Le "Groupe marchandise"
// reprend la même liste que la colonne Fournitures de l'Opérationnel, et la
// "Précision" propose les intitulés déjà utilisés sur des sujets
// exploitation, pour rattacher une question à un objet réel déjà rencontré.
model CahierDesCharges {
  id             String   @id @default(cuid())
  groupeMarchandise String?
  fourniture     String?
  precision      String?
  question       String?
  reponseAttendue String?
  obligatoire    String?  @default("Non")
  rem            String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// Référentiel fournisseurs (import Abacus / ERP + ajouts manuels)
model Fournisseur {
  id        String   @id @default(cuid())
  nom       String   @unique
  npa       String? // code postal
  ville     String?
  pays      String?
  manuel    Boolean  @default(false) // ajouté manuellement (hors import Abacus), pour le suivi KPI des nouveaux fournisseurs
  createdAt DateTime @default(now())
}

// Référentiel chantiers (import + ajouts manuels)
model Chantier {
  id        String   @id @default(cuid())
  numero    String   @unique
  nom       String?
  npa       String?
  ville     String?
  manuel    Boolean  @default(false)
  createdAt DateTime @default(now())
}
